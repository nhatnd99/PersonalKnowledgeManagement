# Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Base URL - Points to the backend API server (v1)
# Local development:
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Production on Vercel:
# VITE_API_BASE_URL=https://personal-knowledge-management-sm1t.vercel.app/api/v1

# Application settings
VITE_APP_NAME=Knowledge App
VITE_APP_VERSION=0.1.0

# Feature flags (set to 'true' or 'false')
VITE_ENABLE_KNOWLEDGE_GRAPH=true
VITE_ENABLE_DEBUG_MODE=false
