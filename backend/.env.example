# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/knowledge-app

# MongoDB Atlas (replace with your connection string):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/knowledge-app?retryWrites=true&w=majority

# Database name (optional, can be part of URI)
MONGODB_DB_NAME=knowledge-app

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL for CORS configuration
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Future: Authentication (not implemented in MVP) ─────────────────────────
# JWT_SECRET=your-secure-secret-key-here
# JWT_EXPIRES_IN=7d
