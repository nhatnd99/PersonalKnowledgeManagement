// Prisma schema for Knowledge App
// Database: PostgreSQL (Local PostgreSQL & Neon PostgreSQL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum NoteType {
  NOTE
  FOLDER
}

enum RelationshipType {
  RELATED_TO
  DEPENDS_ON
  REFERENCES
  EXTENDS
  CONTRADICTS
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// Users table — core authenticated account identity.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(100)
  name            String?   @db.VarChar(100)
  avatarUrl       String?   @map("avatar_url") @db.Text
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions          Session[]
  passwordResets    PasswordResetToken[]
  notes             Note[]
  tags              Tag[]
  relationships     NoteRelationship[]

  @@map("users")
}

/// Sessions table — server-side session authentication with hashed tokens.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  deviceName     String?   @map("device_name") @db.VarChar(255)
  userAgent      String?   @map("user_agent") @db.Text
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  expiresAt      DateTime  @map("expires_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

/// PasswordResetTokens table — single-use hashed reset tokens.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// Notes table — core entity representing both content notes and organizational folders.
/// Scoped to authenticated user. Hierarchy is governed by self-referencing parentId.
model Note {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  title         String    @db.VarChar(500)
  type          NoteType  @default(NOTE)
  content       Json?     @db.JsonB
  contentFormat String    @default("json") @map("content_format") @db.VarChar(50)
  parentId      String?   @map("parent_id") @db.Uuid
  sortOrder     Int       @default(0) @map("sort_order")
  isFavorite    Boolean   @default(false) @map("is_favorite")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent Note?  @relation("NoteHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Note[] @relation("NoteHierarchy")

  outgoingRelationships NoteRelationship[] @relation("OutgoingRelations")
  incomingRelationships NoteRelationship[] @relation("IncomingRelations")

  tags NoteTag[]

  @@index([userId])
  @@index([parentId])
  @@index([type])
  @@index([title])
  @@index([archivedAt])
  @@index([isFavorite])
  @@index([updatedAt])
  @@map("notes")
}

/// NoteRelationships table — directional typed connections between notes and folders.
/// Scoped to authenticated user.
model NoteRelationship {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  sourceNoteId     String           @map("source_note_id") @db.Uuid
  sourceType       NoteType         @default(NOTE) @map("source_type")
  targetNoteId     String           @map("target_note_id") @db.Uuid
  targetType       NoteType         @default(NOTE) @map("target_type")
  relationshipType RelationshipType @map("relationship_type")
  description      String?          @db.VarChar(1000)
  label            String?          @db.VarChar(255)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceNote Note @relation("OutgoingRelations", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note @relation("IncomingRelations", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetNoteId, relationshipType])
  @@index([userId])
  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([sourceType])
  @@index([targetType])
  @@index([relationshipType])
  @@map("note_relationships")
}

/// Tags table — centralized taxonomy labels for categorizing notes.
/// Scoped to authenticated user; name is unique per user.
model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(100)
  color       String?  @db.VarChar(20)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

/// NoteTags join table — explicit relational join table between Note and Tag.
model NoteTag {
  noteId    String   @map("note_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}
