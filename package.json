{
  "name": "knowledge-app",
  "version": "0.1.0",
  "description": "Personal Knowledge Management System - Monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend & npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=backend",
    "prisma:status": "npm run prisma:status --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "prisma:studio": "npm run prisma:studio --workspace=backend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "install:all": "npm install --workspace=frontend && npm install --workspace=backend"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "pkm",
    "knowledge-management",
    "notes",
    "knowledge-graph"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
