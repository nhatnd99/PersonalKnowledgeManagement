{
  "name": "knowledge-app",
  "version": "0.1.0",
  "description": "Personal Knowledge Management System - Monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend & npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "install:all": "npm install --workspace=frontend && npm install --workspace=backend"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "pkm",
    "knowledge-management",
    "notes",
    "knowledge-graph"
  ],
  "author": "",
  "license": "MIT"
}
